# =====================================================================
# SismoWatch - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE!
# =====================================================================

# --- User & Group IDs for Linux Container Permissions ---
AIRFLOW_UID=1000
AIRFLOW_GID=1000

# --- Airflow Core Security (Default development keys) ---
AIRFLOW__CORE__FERNET_KEY=ZgeAgRZYfvYbs3ipZofrTGlVdAS4dO1nIThODwq_-jM=
AIRFLOW__WEBSERVER__SECRET_KEY=k8A9Z1mX0vB4nQ7wE2rT5yU8iO1pA3sD

# --- Airflow Admin Credentials (Changed from default admin/admin) ---
_AIRFLOW_WWW_USER_USERNAME=sismo_admin
_AIRFLOW_WWW_USER_PASSWORD=admin123
_AIRFLOW_WWW_USER_FIRSTNAME=Sismo
_AIRFLOW_WWW_USER_LASTNAME=Admin
_AIRFLOW_WWW_USER_EMAIL=admin@sismowatch.internal

# --- PostgreSQL Superuser & Primary Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123

# --- PostgreSQL Least-Privilege Roles ---
# 1. Ingestion role: Writes solely to bronze schema
DB_INGEST_USER=sismo_ingest
DB_INGEST_PASSWORD=admin123

# 2. Transformation role: Reads bronze, writes to silver and gold
DB_TRANSFORM_USER=sismo_transform
DB_TRANSFORM_PASSWORD=admin123

# 3. Readonly role: Reads solely from gold schema (used by FastAPI)
DB_READONLY_USER=sismo_readonly
DB_READONLY_PASSWORD=admin123

# --- FastAPI Authentication & Security ---
JWT_SECRET_KEY=f98124b89c372f61e87a2bd01948ce6529ab7801df0498b584a6c0291d90472e
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial platform users seeded via environment
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=admin123
PLATFORM_VIEWER_USER=viewer
PLATFORM_VIEWER_PASSWORD=admin123

# --- AI Provider Configuration ---
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- External Sources ---
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_HISTORICAL_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
