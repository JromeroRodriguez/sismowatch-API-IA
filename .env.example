# =====================================================================
# SismoWatch - Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE!
# =====================================================================

# --- User & Group IDs for Linux Container Permissions ---
AIRFLOW_UID=1002
AIRFLOW_GID=1002

# --- Airflow Core Security ---
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_generated_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_airflow_webserver_secret_key_here

# --- Airflow Admin Credentials (Changed from default admin/admin) ---
_AIRFLOW_WWW_USER_USERNAME=sismo_admin
_AIRFLOW_WWW_USER_PASSWORD=ChangeThisAirflowPassword2026!
_AIRFLOW_WWW_USER_FIRSTNAME=Sismo
_AIRFLOW_WWW_USER_LASTNAME=Admin
_AIRFLOW_WWW_USER_EMAIL=admin@sismowatch.internal

# --- PostgreSQL Superuser & Primary Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisSuperuserPassword2026!

# --- PostgreSQL Least-Privilege Roles ---
# 1. Ingestion role: Writes solely to bronze schema
DB_INGEST_USER=sismo_ingest
DB_INGEST_PASSWORD=ChangeThisIngestPassword2026!

# 2. Transformation role: Reads bronze, writes to silver and gold
DB_TRANSFORM_USER=sismo_transform
DB_TRANSFORM_PASSWORD=ChangeThisTransformPassword2026!

# 3. Readonly role: Reads solely from gold schema (used by FastAPI)
DB_READONLY_USER=sismo_readonly
DB_READONLY_PASSWORD=ChangeThisReadonlyPassword2026!

# --- FastAPI Authentication & Security ---
JWT_SECRET_KEY=change_this_jwt_secret_key_minimum_32_characters_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial platform users seeded via environment (never hardcoded in code)
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=ChangeThisPlatformAdminPass2026!
PLATFORM_VIEWER_USER=viewer
PLATFORM_VIEWER_PASSWORD=ChangeThisPlatformViewerPass2026!

# --- AI Provider Configuration ---
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- External Sources ---
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_HISTORICAL_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
